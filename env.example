# ---- Response ingestion (pick ONE) ----------------------------------------
# Option A (EASIEST, no credentials): sheet shared "Anyone with the link".
# Paste the sheet ID from the URL between /d/ and /edit -- a full URL works too,
# and the tab's gid is extracted from it automatically.
#
# SDIS 2026 form responses (pre-filled -- change for a new cohort):
GOOGLE_SHEET_ID=1ZVwPOVBZlzhgCc85GAGK_zJc83jfcN3xX2MbzIrDRRk
GOOGLE_SHEET_GID=1695451547
GOOGLE_WORKSHEET=Form Responses 1

# Option B: private sheet + service account (most secure; sheet stays private)
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json

# Option C: sheet published to the web as CSV
FORM_CSV_URL=

# Option D: offline rehearsal with generated sample data
LOCAL_CSV=data/raw_responses.csv

# ---- Anonymization ---------------------------------------------------------
# Change this per cohort so IDs are not comparable across years.
ANON_SALT=immersion-2027

# ---- Spotify ---------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# From scripts/get_spotify_refresh_token.py — required to actually create the playlist
SPOTIFY_REFRESH_TOKEN=

# ---- Apple Music -----------------------------------------------------------
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=./secrets/AuthKey_XXXXXXXX.p8
APPLE_STOREFRONT=us
# Only needed to create the playlist in a library (MusicKit JS, one-time)
APPLE_MUSIC_USER_TOKEN=

# ---- Playlist metadata -----------------------------------------------------
PLAYLIST_NAME=MADS Immersion — Cohort Playlist
PLAYLIST_DESCRIPTION=One song from every person in the cohort, sequenced by the taste map.

# ---- Credential-free matching (step 04) ------------------------------------
# Storefront for the public iTunes catalog lookup, and politeness delay in seconds.
ITUNES_COUNTRY=US
ITUNES_DELAY=1.2
